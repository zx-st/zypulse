# Copy this file to .env locally, then set your own project API key. Never commit .env.
OPENAI_API_KEY=your_project_api_key_here
# Optional: defaults to gpt-5.4-mini.
OPENAI_MODEL=gpt-5.4-mini
# Comma-separated deployed frontend origins, for example:
# FRONTEND_ORIGINS=https://zypulse-demo.onrender.com
